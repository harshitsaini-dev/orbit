# ---- app ----
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# local  = single user, no OTP, local sqlite file
# hosted = multi user, email OTP, Turso
AUTH_MODE=local

# Only needed in hosted mode when the app and API live on different subdomains.
COOKIE_DOMAIN=

# ---- database ----
# Leave blank in local mode - defaults to <repo-root>/orbit.db.
# A relative file: path is resolved against the repo root, not your shell's cwd.
# hosted: libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---- crypto ----
# 32-byte key, base64. generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# ---- email (Resend) ----
RESEND_API_KEY=
RESEND_FROM="Orbit <no-reply@signal.harshitsaini.in>"

# ---- sync ----
SYNC_CRON=*/15 * * * *

# ---- rate limiting (requests per window, per IP) ----
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000
API_RATE_LIMIT=120
API_RATE_WINDOW_MS=60000

# ---- provider oauth (fill per provider as adapters land) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
