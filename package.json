{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-cloud drive aggregation platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@orbit/server & npm run dev --workspace=@orbit/web",
    "dev:server": "npm run dev --workspace=@orbit/server",
    "dev:web": "npm run dev --workspace=@orbit/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --headed",
    "test:e2e:ci": "playwright test",
    "db:generate": "npm run db:generate --workspace=@orbit/db",
    "db:migrate": "npm run db:migrate --workspace=@orbit/db"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
