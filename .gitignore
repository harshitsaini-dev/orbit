# dependencies
node_modules/
.npm/

# builds
dist/
build/
.vite/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# local database
*.db
*.db-journal
*.sqlite
*.sqlite3

# test artifacts
test-results/
playwright-report/
blob-report/
.playwright/

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# agent tooling (never committed)
.claude/
CLAUDE.md
AGENTS.md

# scratch
.probe/
orbit-e2e.db
orbit-e2e.db-wal
orbit-e2e.db-shm
orbit.db-wal
orbit.db-shm

# background server output from start.bat
logs/

# vite-plugin-pwa writes the development service worker here
dev-dist/

# the share page's viewer, built into the server rather than committed
apps/server/public/share/

# Portfolio cover, icon and gallery shots.
#
# These are uploaded to the portfolio CMS and served from its object storage.
# Committing them here as well would leave two copies of the same picture with
# no way to tell which one the site is actually serving - and the one in git
# would go stale the first time the CMS copy is replaced.
#
# The render and screenshot scripts sit in the same directory and are ignored
# with it. If they are ever wanted in version control, move them somewhere that
# is not `covers/` rather than carving an exception out of this rule.
/covers/
